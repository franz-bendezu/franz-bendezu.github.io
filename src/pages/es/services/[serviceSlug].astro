---
import ServicePage from "@/views/ServicePage.astro";
import { getServices } from "@/lib/services";

export async function getStaticPaths() {
  return (await getServices("es")).map(({ slug }) => ({
    params: { serviceSlug: slug },
  }));
}
const serviceSlug = Astro.params.serviceSlug!;
---

<ServicePage locale="es" slug={serviceSlug} />
