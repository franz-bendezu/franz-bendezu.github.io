---
import ProjectPage from "@/views/ProjectPage.astro";
import { getProjects } from "@/lib/projects";

export async function getStaticPaths() {
  return (await getProjects("en")).map(({ code: projectCode }) => ({
    params: { projectCode },
  }));
}
const projectCode = Astro.params.projectCode!;
---

<ProjectPage locale="en" code={projectCode} />
