---
import ProjectsPage from "@/views/ProjectsPage.astro";
import { PROJECT_CATEGORIES } from "@/constants/project-categories";
import { LOCALES, type Locale } from "@/lib/i18n";
import type { ProjectCategoryCodes } from "@/interfaces/project";
export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    PROJECT_CATEGORIES.map((category) => ({
      params: { locale, category: category.value },
    })),
  );
}
const locale = Astro.params.locale as Locale;
const category = Astro.params.category as ProjectCategoryCodes;
---

<ProjectsPage
  locale={locale}
  category={category}
  prefixEnglish={locale === "en"}
/>
