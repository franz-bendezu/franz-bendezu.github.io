---
import { Font } from "astro:assets";
import "@/styles/global.css";
import Navbar from "@/components/layout/Navbar.astro";
import Footer from "@/components/layout/Footer.astro";
import {
  alternatePaths,
  canonicalPath,
  useTranslations,
  type Locale,
} from "@/lib/i18n";

interface Props {
  locale: Locale;
  path?: string;
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  locale,
  path = "/",
  title,
  description: descriptionProp,
  image = "/opengraph-image.png",
  robots,
  structuredData,
} = Astro.props;
const t = useTranslations(locale);
const description = descriptionProp ?? t("Metadata.description");
const defaultTitle = t("Metadata.title.default");
const template = t("Metadata.title.template");
const pageTitle = title
  ? template.replace("%s", title)
  : template.replace("%s", defaultTitle);
const canonical = new URL(canonicalPath(locale, path), Astro.site);
const alternates = alternatePaths(path);
const structuredDataItems = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const UMAMI_SCRIPT_SRC = "https://cloud.umami.is/script.js";
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiEnabled = import.meta.env.PROD && umamiWebsiteId;
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      if (window.trustedTypes && !window.trustedTypes.defaultPolicy) {
        window.trustedTypes.createPolicy("default", {
          createScriptURL(value) {
            const url = new URL(value, window.location.href);
            const allowedOrigins = new Set([
              window.location.origin,
              "https://cloud.umami.is",
              "https://www.google.com",
              "https://www.gstatic.com",
            ]);
            if (!allowedOrigins.has(url.origin)) {
              throw new TypeError(`Blocked script URL: ${url.origin}`);
            }
            return url.href;
          },
        });
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <Font cssVariable="--font-inter" preload />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(alternates.en, Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={new URL(alternates.es, Astro.site)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates["x-default"], Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Franz Bendezu" />
    <meta property="og:locale" content={t("Metadata.ogLocale")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <title>{pageTitle}</title>
    {
      structuredDataItems.map((item) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(item).replaceAll("<", "\\u003c")}
        />
      ))
    }
    {
      umamiEnabled && (
        <script
          is:inline
          type="text/partytown"
          src={UMAMI_SCRIPT_SRC}
          data-website-id={umamiWebsiteId}
          data-domains={Astro.site?.hostname}
          data-do-not-track="true"
          data-exclude-search="true"
        />
      )
    }
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const dark =
          saved === "dark" ||
          (!saved && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <div class="flex min-h-screen flex-col bg-surface text-content">
      <Navbar locale={locale} path={path} pathname={Astro.url.pathname} />
      <main class="flex flex-grow flex-col items-center align-middle">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>(
        "[data-theme-toggle]",
      );
      const updateThemeIcon = () => {
        const dark = document.documentElement.classList.contains("dark");
        document
          .querySelector("[data-theme-moon]")
          ?.classList.toggle("hidden", dark);
        document
          .querySelector("[data-theme-sun]")
          ?.classList.toggle("hidden", !dark);
        themeButton?.setAttribute("aria-pressed", String(dark));
      };
      updateThemeIcon();
      themeButton?.addEventListener("click", () => {
        const dark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", dark);
        localStorage.setItem("theme", dark ? "dark" : "light");
        updateThemeIcon();
      });
    </script>
  </body>
</html>
