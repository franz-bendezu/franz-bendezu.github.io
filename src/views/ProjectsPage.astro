---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/project/ProjectCard";
import { ProjectExplorerList } from "@/components/project/ExplorerList";
import { PROJECT_CATEGORIES } from "@/constants/project-categories";
import { getProjects } from "@/lib/projects";
import { optimizeProjectBanners } from "@/lib/project-images";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
import type { ProjectCategoryCodes } from "@/interfaces/project";
interface Props {
  locale: Locale;
  category?: ProjectCategoryCodes;
}
const { locale, category } = Astro.props;
const path = category ? `/projects/c/${category}` : "/projects";
const projects = await getProjects(locale, category);
const rawFeatured = category
  ? []
  : projects
      .filter((project) => project.featured)
      .sort((a, b) => a.position - b.position);
const rawArchive = category
  ? projects
  : projects.filter((project) => !project.featured);
const [featured, archive] = await Promise.all([
  optimizeProjectBanners(rawFeatured),
  optimizeProjectBanners(rawArchive),
]);
const projectBasePath = localizedPath(locale, "/projects");
const labels = {
  filteredBy: translate(locale, "Projects.filteredBy"),
  empty: translate(locale, "Projects.empty"),
  viewProject: translate(locale, "Projects.viewProjectLink", {
    title: "{title}",
  }),
  filterTech: translate(locale, "Projects.filterTech"),
  clearFilters: translate(locale, "Projects.clearFilters"),
  resultCount: translate(locale, "Projects.resultCount", { count: "{count}" }),
};
const title = category
  ? `${PROJECT_CATEGORIES.find((item) => item.value === category)?.name} · ${translate(locale, "Projects.title")}`
  : translate(locale, "Projects.title");
---

<BaseLayout
  locale={locale}
  path={path}
  title={title}
  description={translate(locale, "Projects.metaDescription")}
  robots={category ? "noindex,follow" : undefined}
>
  <section
    data-testid="projects"
    class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 py-12 sm:py-16"
  >
    <div class="max-w-3xl">
      <p
        class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
      >
        {locale === "es" ? "Portafolio" : "Portfolio"}
      </p>
      <h1 class="mt-4 text-5xl font-bold tracking-[-0.045em] sm:text-7xl">
        {translate(locale, "Projects.title")}<span class="text-accent">.</span>
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-content-muted">
        {translate(locale, "Projects.intro")}
      </p>
    </div>
    <nav
      aria-label={locale === "es"
        ? "Categorías de proyecto"
        : "Project categories"}
      class="mt-10 flex flex-wrap gap-2 border-b border-divider pb-5"
    >
      <a
        class:list={[
          "rounded-full border px-4 py-2 text-sm font-semibold",
          !category
            ? "border-accent bg-accent-soft text-accent-strong"
            : "border-divider hover:border-accent",
        ]}
        href={localizedPath(locale, "/projects")}
        >{translate(locale, "Projects.categories.all")}</a
      >
      {
        PROJECT_CATEGORIES.map((item) => (
          <a
            class:list={[
              "rounded-full border px-4 py-2 text-sm font-semibold",
              category === item.value
                ? "border-accent bg-accent-soft text-accent-strong"
                : "border-divider hover:border-accent",
            ]}
            href={localizedPath(locale, `/projects/c/${item.value}`)}
          >
            {item.name}
          </a>
        ))
      }
    </nav>
    {
      featured.length > 0 && (
        <section class="mt-14">
          <>
            <p class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase">
              {translate(locale, "Projects.featured")}
            </p>
            <div class="mt-6 grid gap-5 lg:grid-cols-3">
              {featured.map((project) => (
                <ProjectCard
                  project={project}
                  href={localizedPath(locale, `/projects/${project.code}`)}
                  labels={{
                    viewProject: translate(locale, "Projects.viewProjectLink", {
                      title: project.title,
                    }),
                    impact: translate(locale, "Home.lastProjects.impact"),
                    caseStudy: translate(locale, "Home.lastProjects.caseStudy"),
                  }}
                  variant="featured"
                />
              ))}
            </div>
          </>
        </section>
      )
    }
    <section class="mt-16">
      <h2 class="text-3xl font-bold tracking-tight">
        {category ? title : translate(locale, "Projects.archive")}
      </h2>
      <ProjectExplorerList
        client:load
        projects={archive}
        projectBasePath={projectBasePath}
        labels={labels}
      />
    </section>
  </section>
</BaseLayout>
