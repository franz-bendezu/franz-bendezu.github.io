---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/project/ProjectCard";
import { ProjectExplorerList } from "@/components/project/ExplorerList";
import { PROJECT_CATEGORIES } from "@/constants/project-categories";
import { getProjects } from "@/lib/projects";
import { optimizeProjectBanners } from "@/lib/project-images";
import { useLocalizedPath, useTranslations, type Locale } from "@/lib/i18n";
import type { ProjectCategoryCodes } from "@/interfaces/project";
interface Props {
  locale: Locale;
  category?: ProjectCategoryCodes;
}
const { locale, category } = Astro.props;
const localizePath = useLocalizedPath(locale);
const t = useTranslations(locale);
const path = category ? `/projects/c/${category}` : "/projects";
const projects = await getProjects(locale, category);
const rawFeatured = category
  ? []
  : projects
      .filter((project) => project.featured)
      .sort((a, b) => a.position - b.position);
const rawArchive = category
  ? projects
  : projects.filter((project) => !project.featured);
const [featured, archive] = await Promise.all([
  optimizeProjectBanners(rawFeatured),
  optimizeProjectBanners(rawArchive),
]);
const projectBasePath = localizePath("/projects");
const labels = {
  filteredBy: t("Projects.filteredBy"),
  empty: t("Projects.empty"),
  viewProject: t("Projects.viewProjectLink", {
    title: "{title}",
  }),
  filterTech: t("Projects.filterTech"),
  clearFilters: t("Projects.clearFilters"),
  resultCount: t("Projects.resultCount", { count: "{count}" }),
};
const title = category
  ? `${PROJECT_CATEGORIES.find((item) => item.value === category)?.name} · ${t("Projects.title")}`
  : t("Projects.title");
---

<BaseLayout
  locale={locale}
  path={path}
  title={title}
  description={t("Projects.metaDescription")}
  robots={category ? "noindex,follow" : undefined}
>
  <section
    data-testid="projects"
    class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 py-12 sm:py-16"
  >
    <div class="max-w-3xl">
      <p
        class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
      >
        {t("Projects.eyebrow")}
      </p>
      <h1 class="mt-4 text-5xl font-bold tracking-[-0.045em] sm:text-7xl">
        {t("Projects.title")}<span class="text-accent">.</span>
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-content-muted">
        {t("Projects.intro")}
      </p>
    </div>
    <nav
      aria-label={t("Projects.categoriesLabel")}
      class="mt-10 flex flex-wrap gap-2 border-b border-divider pb-5"
    >
      <a
        class:list={[
          "rounded-full border px-4 py-2 text-sm font-semibold",
          !category
            ? "border-accent bg-accent-soft text-accent-strong"
            : "border-divider hover:border-accent",
        ]}
        href={localizePath("/projects")}>{t("Projects.categories.all")}</a
      >
      {
        PROJECT_CATEGORIES.map((item) => (
          <a
            class:list={[
              "rounded-full border px-4 py-2 text-sm font-semibold",
              category === item.value
                ? "border-accent bg-accent-soft text-accent-strong"
                : "border-divider hover:border-accent",
            ]}
            href={localizePath(`/projects/c/${item.value}`)}
          >
            {item.name}
          </a>
        ))
      }
    </nav>
    {
      featured.length > 0 && (
        <section class="mt-14">
          <>
            <h2 class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase">
              {t("Projects.featured")}
            </h2>
            <div class="mt-6 grid gap-5 lg:grid-cols-3">
              {featured.map((project) => (
                <ProjectCard
                  project={project}
                  href={localizePath(`/projects/${project.code}`)}
                  labels={{
                    viewProject: t("Projects.viewProjectLink", {
                      title: project.title,
                    }),
                    impact: t("Home.lastProjects.impact"),
                    caseStudy: t("Home.lastProjects.caseStudy"),
                  }}
                  variant="featured"
                />
              ))}
            </div>
          </>
        </section>
      )
    }
    <section class="mt-16">
      <h2 class="text-3xl font-bold tracking-tight">
        {category ? title : t("Projects.archive")}
      </h2>
      <ProjectExplorerList
        client:idle
        projects={archive}
        projectBasePath={projectBasePath}
        labels={labels}
      />
    </section>
  </section>
</BaseLayout>
