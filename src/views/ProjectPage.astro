---
import { CheckIcon } from "@heroicons/react/20/solid";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ProjectImagesCarousel } from "@/components/project/Images";
import LinkIcon from "@/components/project/LinkIcon.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import cardStyles from "@/components/ui/Card.module.css";
import { getProjects } from "@/lib/projects";
import {
  optimizeProjectBanner,
  optimizeProjectGallery,
} from "@/lib/project-images";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
import { breadcrumbSchema, SITE_URL } from "@/lib/seo";
interface Props {
  locale: Locale;
  code: string;
}
const { locale, code } = Astro.props;
const localizedProjects = (await getProjects(locale)).sort(
  (a, b) => a.position - b.position,
);
const baseProject = localizedProjects.find((item) => item.code === code);
if (!baseProject) return Astro.redirect("/404");
const project = await optimizeProjectBanner(baseProject);
const projectImages = await optimizeProjectGallery(project.images);
const currentIndex = localizedProjects.findIndex(
  (item) => item.translationKey === project.translationKey,
);
const previous =
  currentIndex > 0 ? localizedProjects[currentIndex - 1] : undefined;
const next =
  currentIndex < localizedProjects.length - 1
    ? localizedProjects[currentIndex + 1]
    : undefined;
const period = [project.start, project.end].filter(Boolean).join(" — ");
const path = `/projects/${code}`;
const closeLabel = locale === "es" ? "Cerrar" : "Close";
const canonicalUrl = `${SITE_URL}${localizedPath(locale, path)}`;
const projectsUrl = `${SITE_URL}${localizedPath(locale, "/projects")}`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${canonicalUrl}#case-study`,
    url: canonicalUrl,
    name: project.title,
    description: project.shortDescription,
    inLanguage: locale,
    creator: {
      "@type": "Person",
      "@id": `${SITE_URL}/#person`,
      name: "Franz Antony Bendezu Isidro",
    },
    ...(project.banner && { image: `${SITE_URL}${project.banner.src}` }),
    keywords: project.tags,
    dateCreated: project.start,
  },
  breadcrumbSchema([
    {
      name: locale === "es" ? "Inicio" : "Home",
      url: `${SITE_URL}${localizedPath(locale, "/")}`,
    },
    { name: translate(locale, "Projects.title"), url: projectsUrl },
    { name: project.title, url: canonicalUrl },
  ]),
];
---

<BaseLayout
  locale={locale}
  path={path}
  title={project.title}
  description={project.shortDescription}
  image={project.banner?.src}
  structuredData={structuredData}
>
  <article class="w-full">
    <header
      class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 py-12 sm:py-16 lg:py-20"
    >
      <a
        href={localizedPath(locale, "/projects")}
        class="inline-flex items-center gap-2 text-sm font-bold text-accent-strong"
        >← {translate(locale, "Projects.title")}</a
      >
      <div
        class="mt-8 grid items-center gap-10 lg:grid-cols-[1fr_0.9fr] lg:gap-16"
      >
        <div>
          <p
            class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
          >
            {project.categoryCode} · {project.status}
          </p>
          <h1
            class="mt-4 text-4xl font-bold leading-[1.02] tracking-[-0.045em] sm:text-6xl"
          >
            {project.title}
          </h1>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-content-muted">
            {project.shortDescription}
          </p>
          <dl
            class="mt-8 grid gap-4 border-y border-divider py-5 sm:grid-cols-2"
          >
            <div>
              <dt
                class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
              >
                {translate(locale, "Project.role")}
              </dt><dd class="mt-2 font-semibold">
                {
                  project.role ??
                    (locale === "es"
                      ? "Ingeniería de software"
                      : "Software engineering")
                }
              </dd>
            </div>
            <div>
              <dt
                class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
              >
                {translate(locale, "Project.period")}
              </dt><dd class="mt-2 font-mono text-sm">
                {period || "—"}
              </dd>
            </div>
          </dl>
          {
            project.links?.length && (
              <div class="mt-6 flex flex-wrap gap-2">
                {project.links.map((link) => (
                  <ButtonLink href={link.url} external variant="secondary">
                    <LinkIcon type={link.type} class="h-4 w-4" />
                    {link.title}
                  </ButtonLink>
                ))}
              </div>
            )
          }
        </div>
        <div
          class:list={[
            cardStyles.base,
            "aspect-video overflow-hidden bg-surface-muted",
          ]}
        >
          {
            project.banner ? (
              <img
                src={project.banner.src}
                srcset={project.banner.srcSet}
                sizes="(min-width: 1024px) 40vw, 100vw"
                alt={project.banner.alt}
                width={project.banner.width}
                height={project.banner.height}
                class="h-full w-full object-contain"
                fetchpriority="high"
              />
            ) : (
              <div class="flex h-full items-center justify-center font-mono text-5xl text-accent-strong">
                {project.title.slice(0, 2)}
              </div>
            )
          }
        </div>
      </div>
    </header>

    <section class="border-y border-divider bg-surface-muted py-16 sm:py-20">
      <div
        class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 grid gap-10 lg:grid-cols-2 lg:gap-20"
      >
        <div>
          <p
            class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
          >
            01
          </p><h2 class="mt-3 text-3xl font-bold">
            {translate(locale, "Project.challenge")}
          </h2><p class="mt-5 text-lg leading-relaxed text-content-muted">
            {project.challenge}
          </p>
        </div>
        <div>
          <p
            class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
          >
            02
          </p><h2 class="mt-3 text-3xl font-bold">
            {translate(locale, "Project.approach")}
          </h2><p class="mt-5 text-lg leading-relaxed text-content-muted">
            {project.approach}
          </p>
        </div>
      </div>
      <div
        class="mx-auto mt-12 w-full max-w-[75rem] border-t border-divider px-5 pt-10 sm:px-8"
      >
        <p
          class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
        >
          {translate(locale, "Project.goals")}
        </p>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {
            project.projectGoals.map((goal) => (
              <article class="border-l-2 border-accent pl-4">
                <h3 class="font-bold">{goal.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-content-muted">
                  {goal.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 py-16 sm:py-24">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p
            class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
          >
            03
          </p><h2 class="mt-3 text-3xl font-bold">
            {translate(locale, "Project.impact")}
          </h2><ul class="mt-6 space-y-4">
            {
              project.outcomes.map((outcome) => (
                <li class="flex gap-3 border-b border-divider pb-4">
                  <>
                    <CheckIcon
                      className="mt-0.5 h-5 w-5 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    <span class="font-semibold">{outcome}</span>
                  </>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p
            class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
          >
            {translate(locale, "Project.technologies")}
          </p><div class="mt-5 flex flex-wrap gap-3">
            {
              project.technologies.map((tech) => (
                <span
                  class:list={[
                    cardStyles.base,
                    "flex items-center gap-2 px-3 py-2 font-mono text-xs",
                  ]}
                >
                  {tech.logo && (
                    <img
                      src={tech.logo}
                      alt=""
                      class="h-5 w-5"
                      width="20"
                      height="20"
                      loading="lazy"
                    />
                  )}
                  {tech.name}
                </span>
              ))
            }
          </div>
          <div class="mt-10">
            <p
              class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
            >
              {translate(locale, "Project.features")}
            </p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              {
                project.keyFeatures.map((feature) => (
                  <article class="border-t-2 border-accent pt-4">
                    <h3 class="font-bold">{feature.title}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-content-muted">
                      {feature.description}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      projectImages?.length && (
        <section class="border-y border-divider bg-surface-muted py-16">
          <div class="mx-auto w-full max-w-[75rem] px-5 sm:px-8">
            <>
              <p class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase">
                {locale === "es" ? "Galería" : "Gallery"}
              </p>
              <h2 class="mt-3 mb-8 text-3xl font-bold">
                {locale === "es"
                  ? "El sistema en contexto"
                  : "The system in context"}
              </h2>
              <ProjectImagesCarousel
                client:idle
                images={projectImages}
                closeLabel={closeLabel}
              />
            </>
          </div>
        </section>
      )
    }

    <nav
      aria-label={locale === "es"
        ? "Navegación entre proyectos"
        : "Project navigation"}
      class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 grid gap-4 py-12 sm:grid-cols-2"
    >
      {
        previous ? (
          <a
            href={localizedPath(locale, `/projects/${previous.code}`)}
            class:list={[cardStyles.base, "p-5 hover:border-accent"]}
          >
            <>
              <span class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase">
                ← {translate(locale, "Project.previous")}
              </span>
              <strong class="mt-2 block">{previous.title}</strong>
            </>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={localizedPath(locale, `/projects/${next.code}`)}
            class:list={[cardStyles.base, "p-5 text-right hover:border-accent"]}
          >
            <>
              <span class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase">
                {translate(locale, "Project.next")} →
              </span>
              <strong class="mt-2 block">{next.title}</strong>
            </>
          </a>
        )
      }
    </nav>
    <section class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 pb-16">
      <a
        href={localizedPath(locale, "/contact")}
        class="flex rounded-2xl bg-content p-8 text-2xl font-bold text-surface hover:-translate-y-1 sm:items-center sm:justify-between dark:bg-surface-raised dark:text-content"
        ><span>{translate(locale, "Project.cta")}</span><span aria-hidden="true"
          >↗</span
        ></a
      >
    </section>
  </article>
</BaseLayout>
