---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Presentation from "@/components/home/Presentation.astro";
import Skills from "@/components/home/Skills.astro";
import LastProjects from "@/components/home/LastProjects.astro";
import Services from "@/components/home/Services.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getProjects } from "@/lib/projects";
import { optimizeProjectBanners } from "@/lib/project-images";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
import { getProfile } from "@/lib/profile-content";
import { personSchema, SITE_URL } from "@/lib/seo";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = await optimizeProjectBanners(
  (await getProjects(locale))
    .filter((project) => project.featured)
    .sort((a, b) => a.position - b.position),
);
const profile = await getProfile(locale);
const canonicalUrl = `${SITE_URL}${localizedPath(locale, "/")}`;
const description = translate(locale, "Metadata.description");
const person = personSchema(profile, locale);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    url: SITE_URL,
    name: "Franz Bendezu",
    inLanguage: ["en", "es"],
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "@id": `${canonicalUrl}#profile-page`,
    url: canonicalUrl,
    name:
      locale === "es"
        ? "Franz Bendezu — Desarrollador de software e ingeniero de sistemas"
        : "Franz Bendezu — Software developer and systems engineer",
    description,
    inLanguage: locale,
    mainEntity: person,
  },
  { "@context": "https://schema.org", ...person },
];
---

<BaseLayout
  locale={locale}
  path="/"
  title={locale === "es"
    ? "Desarrollador de software e ingeniero de sistemas"
    : "Software Developer and Systems Engineer"}
  description={description}
  structuredData={structuredData}
>
  <Presentation locale={locale} />
  <Services locale={locale} />
  <Skills locale={locale} />
  <LastProjects projects={projects} locale={locale} />
  <section class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 pb-16 sm:pb-24">
    <div
      class="overflow-hidden rounded-2xl bg-content px-6 py-10 text-surface sm:px-10 sm:py-14 dark:bg-surface-raised dark:text-content"
    >
      <p
        class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
      >
        {translate(locale, "Home.cta.label")}
      </p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h2 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
            {translate(locale, "Home.cta.title")}
          </h2><p class="mt-3 max-w-2xl opacity-75">
            {translate(locale, "Home.cta.description")}
          </p>
        </div>
        <ButtonLink href={localizedPath(locale, "/contact")}
          >{translate(locale, "Home.cta.button")}
          <span aria-hidden="true">↗</span></ButtonLink
        >
      </div>
    </div>
  </section>
</BaseLayout>
