---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Presentation from "@/components/home/Presentation.astro";
import Skills from "@/components/home/Skills.astro";
import LastProjects from "@/components/home/LastProjects.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getProjects } from "@/lib/projects";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
  prefixEnglish?: boolean;
}
const { locale, prefixEnglish = false } = Astro.props;
const projects = (await getProjects(locale))
  .filter((project) => project.featured)
  .sort((a, b) => a.position - b.position);
---

<BaseLayout locale={locale} path="/">
  <Presentation locale={locale} prefixEnglish={prefixEnglish} />
  <Skills locale={locale} prefixEnglish={prefixEnglish} />
  <LastProjects
    projects={projects}
    locale={locale}
    prefixEnglish={prefixEnglish}
  />
  <section class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 pb-16 sm:pb-24">
    <div
      class="overflow-hidden rounded-2xl bg-content px-6 py-10 text-surface sm:px-10 sm:py-14 dark:bg-surface-raised dark:text-content"
    >
      <p
        class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
      >
        {translate(locale, "Home.cta.label")}
      </p>
      <div class="mt-4 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <h2 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">
            {translate(locale, "Home.cta.title")}
          </h2><p class="mt-3 max-w-2xl opacity-75">
            {translate(locale, "Home.cta.description")}
          </p>
        </div>
        <ButtonLink href={localizedPath(locale, "/contact", prefixEnglish)}
          >{translate(locale, "Home.cta.button")}
          <span aria-hidden="true">↗</span></ButtonLink
        >
      </div>
    </div>
  </section>
</BaseLayout>
