---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ContactForm } from "@/components/contact/Form";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Card from "@/components/ui/Card.astro";
import { useTranslations, type Locale } from "@/lib/i18n";
import { getProfile } from "@/lib/profile-content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const profile = await getProfile(locale);
const labels = {
  name: t("Contact.form.name"),
  email: t("Contact.form.email"),
  company: t("Contact.form.company"),
  service: t("Contact.form.service"),
  timeline: t("Contact.form.timeline"),
  message: t("Contact.form.message"),
  send: t("Contact.form.send"),
  successTitle: t("Contact.form.successTitle"),
  successDescription: t("Contact.form.successDescription"),
  error: t("Contact.form.error"),
  recaptcha: t("Contact.form.recaptcha"),
  services: {
    placeholder: t("Contact.form.services.placeholder"),
    "mvp-development": t("Contact.form.services.mvp-development"),
    "saas-product-development": t(
      "Contact.form.services.saas-product-development",
    ),
    "internal-tools": t("Contact.form.services.internal-tools"),
    "landing-page-development": t(
      "Contact.form.services.landing-page-development",
    ),
    unsure: t("Contact.form.services.unsure"),
  },
  timelines: {
    placeholder: t("Contact.form.timelines.placeholder"),
    "under-one-month": t("Contact.form.timelines.under-one-month"),
    "one-to-three-months": t("Contact.form.timelines.one-to-three-months"),
    "over-three-months": t("Contact.form.timelines.over-three-months"),
    exploring: t("Contact.form.timelines.exploring"),
  },
};
const formId = import.meta.env.PUBLIC_FORMSPREE_ID ?? "test";
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<BaseLayout
  locale={locale}
  path="/contact"
  title={t("Contact.title")}
  description={t("Contact.description")}
>
  <section class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 py-12 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p
          class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
        >
          {t("Contact.availability")}
        </p>
        <h1 class="mt-4 text-5xl font-bold tracking-[-0.045em] sm:text-7xl">
          {t("Contact.title")}<span class="text-accent">.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-content-muted">
          {t("Contact.intro")}
        </p>
        <div class="mt-10 border-y border-divider py-5">
          <p
            class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
          >
            {t("Contact.emailLabel")}
          </p><a
            class="mt-2 inline-block text-lg font-bold text-accent-strong hover:underline"
            href={`mailto:${profile.email}`}>{profile.email}</a
          ><p class="mt-2 text-sm text-content-muted">
            {t("Contact.response")}
          </p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          {
            profile.socialLinks.map((link) => (
              <ButtonLink href={link.url} external variant="secondary">
                {link.label} ↗
              </ButtonLink>
            ))
          }
        </div>
      </div>
      <Card class="p-5 sm:p-8">
        {
          recaptchaSiteKey && (
            <script
              is:inline
              src="https://www.google.com/recaptcha/api.js"
              async
              defer
            />
          )
        }
        <ContactForm
          client:load
          formId={formId}
          recaptchaSiteKey={recaptchaSiteKey}
          labels={labels}
          locale={locale}
        />
      </Card>
    </div>
  </section>
</BaseLayout>
