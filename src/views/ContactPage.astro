---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ContactForm } from "@/components/contact/Form";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Card from "@/components/ui/Card.astro";
import { translate, type Locale } from "@/lib/i18n";
import { getProfile } from "@/lib/profile-content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const profile = await getProfile(locale);
const labels = {
  name: translate(locale, "Contact.form.name"),
  email: translate(locale, "Contact.form.email"),
  message: translate(locale, "Contact.form.message"),
  send: translate(locale, "Contact.form.send"),
  successTitle: translate(locale, "Contact.form.successTitle"),
  successDescription: translate(locale, "Contact.form.successDescription"),
  error: translate(locale, "Contact.form.error"),
  recaptcha: translate(locale, "Contact.form.recaptcha"),
};
const formId = import.meta.env.PUBLIC_FORMSPREE_ID ?? "test";
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<BaseLayout
  locale={locale}
  path="/contact"
  title={translate(locale, "Contact.title")}
  description={translate(locale, "Contact.description")}
>
  <section class="mx-auto w-full max-w-[75rem] px-5 sm:px-8 py-12 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p
          class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
        >
          {translate(locale, "Contact.availability")}
        </p>
        <h1 class="mt-4 text-5xl font-bold tracking-[-0.045em] sm:text-7xl">
          {translate(locale, "Contact.title")}<span class="text-accent">.</span>
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-content-muted">
          {translate(locale, "Contact.intro")}
        </p>
        <div class="mt-10 border-y border-divider py-5">
          <p
            class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
          >
            {translate(locale, "Contact.emailLabel")}
          </p><a
            class="mt-2 inline-block text-lg font-bold text-accent-strong hover:underline"
            href={`mailto:${profile.email}`}>{profile.email}</a
          ><p class="mt-2 text-sm text-content-muted">
            {translate(locale, "Contact.response")}
          </p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          {
            profile.socialLinks.map((link) => (
              <ButtonLink href={link.url} external variant="secondary">
                {link.label} ↗
              </ButtonLink>
            ))
          }
        </div>
      </div>
      <Card class="p-5 sm:p-8">
        {
          recaptchaSiteKey && (
            <script
              is:inline
              src="https://www.google.com/recaptcha/api.js"
              async
              defer
            />
          )
        }
        <ContactForm
          client:load
          formId={formId}
          recaptchaSiteKey={recaptchaSiteKey}
          labels={labels}
        />
      </Card>
    </div>
  </section>
</BaseLayout>
