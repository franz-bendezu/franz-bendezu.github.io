---
import Card from "@/components/ui/Card.astro";

interface Props {
  degree: string;
  institution: string;
  location: string;
  link?: string;
}
const props = Astro.props;
---

<Card variant="flat" class="p-5">
  <h3 class="font-bold">{props.degree}</h3>{
    props.link ? (
      <a
        href={props.link}
        class="mt-2 inline-block text-sm font-semibold text-accent-strong"
      >
        {props.institution}
      </a>
    ) : (
      <p class="mt-2 text-sm font-semibold">{props.institution}</p>
    )
  }<p class="mt-1 font-mono text-xs uppercase text-content-muted">
    {props.location}
  </p>
</Card>
