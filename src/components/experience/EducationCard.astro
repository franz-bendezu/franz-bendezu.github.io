---
interface Props {
  degree: string;
  institution: string;
  location: string;
  link?: string;
}
const props = Astro.props;
---

<article
  class="rounded-2xl border border-divider bg-surface-raised shadow-editorial p-5 shadow-none"
>
  <h3 class="font-bold">{props.degree}</h3>{
    props.link ? (
      <a
        href={props.link}
        class="mt-2 inline-block text-sm font-semibold text-accent-strong"
      >
        {props.institution}
      </a>
    ) : (
      <p class="mt-2 text-sm font-semibold">{props.institution}</p>
    )
  }<p class="mt-1 font-mono text-xs uppercase text-content-muted">
    {props.location}
  </p>
</article>
