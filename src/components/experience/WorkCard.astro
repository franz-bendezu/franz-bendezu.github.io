---
interface Props {
  company: string;
  position: string;
  start: string;
  end: string;
  link?: string;
  tasks: readonly string[];
  compact?: boolean;
}
const props = Astro.props;
---

<article
  class:list={[
    "rounded-2xl border border-divider bg-surface-raised shadow-editorial border-l-4 border-l-accent p-5 sm:p-6",
    props.compact && "shadow-none",
  ]}
>
  <div
    class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between"
  >
    <div>
      <h3 class="text-xl font-bold">{props.position}</h3>{
        props.link ? (
          <a
            href={props.link}
            class="mt-1 inline-block font-semibold text-accent-strong"
          >
            {props.company}
          </a>
        ) : (
          <p class="mt-1 font-semibold text-accent-strong">{props.company}</p>
        )
      }
    </div><p
      class="font-mono text-xs uppercase tracking-wider text-content-muted"
    >
      {props.start} — {props.end}
    </p>
  </div>
  {
    props.tasks.length > 0 && (
      <ul class="mt-5 grid gap-2 text-sm leading-relaxed text-content-muted">
        {props.tasks.map((task) => (
          <li class="flex gap-3">
            <span class="text-accent" aria-hidden="true">
              →
            </span>
            <span>{task}</span>
          </li>
        ))}
      </ul>
    )
  }
</article>
