---
import Card from "@/components/ui/Card.astro";
import type { Locale } from "@/lib/i18n";
import { getCertifications } from "@/lib/profile-content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const certifications = await getCertifications(locale);
---

<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
  {
    certifications.map((certification) => (
      <Card variant="flat" class="p-4 hover:border-accent">
        <h3 class="font-semibold leading-tight">{certification.name}</h3>
        <p class="mt-2 font-mono text-xs text-content-muted">
          {certification.date}
        </p>
        <a
          href={certification.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex text-sm font-bold text-accent-strong hover:underline"
        >
          {locale === "es" ? "Ver certificación" : "View certification"}
        </a>
      </Card>
    ))
  }
</div>
