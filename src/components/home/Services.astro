---
import { ArrowRightIcon } from "@heroicons/react/20/solid";
import Card from "@/components/ui/Card.astro";
import { getServices } from "@/lib/services";
import { localizedPath, translate, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const services = await getServices(locale);
const basePath = "/services";
---

<section class="border-y border-divider bg-surface-muted py-16 sm:py-24">
  <div class="mx-auto w-full max-w-[75rem] px-5 sm:px-8">
    <div class="max-w-3xl">
      <p
        class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
      >
        {translate(locale, "Services.eyebrow")}
      </p>
      <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-5xl">
        {translate(locale, "Services.title")}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-content-muted">
        {translate(locale, "Services.description")}
      </p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, index) => (
          <Card variant="interactive" class="flex flex-col p-5">
            <span class="font-mono text-xs font-bold text-accent-strong">
              0{index + 1}
            </span>
            <h3 class="mt-5 text-xl font-bold">{service.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-content-muted">
              {service.description}
            </p>
            <a
              href={localizedPath(locale, `${basePath}/${service.slug}`)}
              data-astro-prefetch
              class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-accent-strong"
            >
              {translate(locale, "Services.viewService")}
              <ArrowRightIcon className="h-4 w-4" aria-hidden="true" />
            </a>
          </Card>
        ))
      }
    </div>
  </div>
</section>
