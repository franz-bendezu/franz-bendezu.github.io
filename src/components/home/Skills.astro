---
import {
  CloudIcon,
  CodeBracketIcon,
  ServerStackIcon,
} from "@heroicons/react/20/solid";
import { useLocalizedPath, useTranslations, type Locale } from "@/lib/i18n";
import { getSkills } from "@/lib/profile-content";
import Card from "@/components/ui/Card.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const localizePath = useLocalizedPath(locale);
const t = useTranslations(locale);
const skills = await getSkills(locale);
const find = (code: string) =>
  skills.find((skill) => skill.id === code)?.items.slice(0, 5) ?? [];
const capabilities = [
  {
    title: "Backend systems",
    description: t("Home.skills.backend"),
    items: find("backend"),
    icon: ServerStackIcon,
  },
  {
    title: "Cloud & delivery",
    description: t("Home.skills.cloud"),
    items: find("cloud"),
    icon: CloudIcon,
  },
  {
    title: "Web platforms",
    description: t("Home.skills.frontend"),
    items: find("frontend"),
    icon: CodeBracketIcon,
  },
];
---

<section
  id="skills"
  class="border-y border-divider bg-surface-muted py-16 sm:py-24"
>
  <div class="mx-auto w-full max-w-[75rem] px-5 sm:px-8">
    <div class="max-w-3xl">
      <p
        class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
      >
        {t("Home.skills.label")}
      </p>
      <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-5xl">
        {t("Home.skills.title")}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-content-muted">
        {t("Home.skills.description")}
      </p>
    </div>
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {
        capabilities.map(({ title, description, items, icon: Icon }) => (
          <Card
            variant="interactive"
            class="group p-6"
          >
            <Icon className="h-7 w-7 text-accent" aria-hidden="true" />
            <h3 class="mt-8 text-2xl font-bold">{title}</h3>
            <p class="mt-3 leading-relaxed text-content-muted">{description}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {items.map((item) => (
                <span class="rounded-full border border-divider px-2.5 py-1 font-mono text-xs">
                  {item}
                </span>
              ))}
            </div>
            <a
              href={localizePath("/projects")}
              class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-accent-strong"
            >
              {t("Home.skills.evidence")} <span aria-hidden="true">→</span>
            </a>
          </Card>
        ))
      }
    </div>
  </div>
</section>
