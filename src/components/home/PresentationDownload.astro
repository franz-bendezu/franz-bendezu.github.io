---
import { ArrowDownTrayIcon } from "@heroicons/react/20/solid";
import { translate, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a
  href={translate(locale, "Home.cvPath")}
  download="Franz Bendezu CV.pdf"
  class="inline-flex min-h-11 items-center justify-center gap-2 rounded-[0.65rem] border border-divider bg-transparent px-4 py-2.5 text-sm font-bold text-content hover:-translate-y-0.5 hover:border-accent hover:text-accent-strong whitespace-nowrap"
>
  <ArrowDownTrayIcon className="h-4 w-4" aria-hidden="true" />
  <span class="text-sm font-semibold"
    >{translate(locale, "Home.downloadCV")}</span
  >
</a>
