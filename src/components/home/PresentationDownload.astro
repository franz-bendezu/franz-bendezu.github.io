---
import { ArrowDownTrayIcon } from "@heroicons/react/20/solid";
import { translate, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a
  href={translate(locale, "Home.cvPath")}
  download="Franz Bendezu CV.pdf"
  class="inline-flex items-center justify-center whitespace-nowrap rounded-lg border border-slate-500 bg-slate-600 px-3 py-1.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-slate-700 focus-visible:outline-none focus-visible:ring focus-visible:ring-slate-300 focus-visible:ring-indigo-300 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-900 dark:focus-visible:ring-slate-600"
>
  <ArrowDownTrayIcon
    className="mr-2 h-4 w-4 fill-slate-100 dark:fill-slate-500"
    aria-hidden="true"
  />
  <span class="text-sm font-semibold">{translate(locale, "Home.downloadCV")}</span>
</a>
