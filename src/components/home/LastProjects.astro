---
import ProjectCard from "@/components/astro/ProjectCard.astro";
import type { IProject } from "@/interfaces/project";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
interface Props {
  projects: IProject[];
  locale: Locale;
  prefixEnglish?: boolean;
}
const { projects, locale, prefixEnglish = false } = Astro.props;
---

<section id="projects" class="py-16 sm:py-24">
  <div class="mx-auto w-full max-w-[75rem] px-5 sm:px-8">
    <div
      class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-3xl">
        <p
          class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
        >
          {translate(locale, "Home.lastProjects.label")}
        </p>
        <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-5xl">
          {translate(locale, "Home.lastProjects.title")}
        </h2>
        <p class="mt-4 text-lg text-content-muted">
          {translate(locale, "Home.lastProjects.description")}
        </p>
      </div>
      <a
        href={localizedPath(locale, "/projects", prefixEnglish)}
        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-[0.65rem] border border-divider bg-transparent px-4 py-2.5 text-sm font-bold text-content hover:-translate-y-0.5 hover:border-accent hover:text-accent-strong shrink-0"
        >{translate(locale, "Home.lastProjects.viewAll")}</a
      >
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        projects.map((project) => (
          <ProjectCard
            project={project}
            locale={locale}
            prefixEnglish={prefixEnglish}
          />
        ))
      }
    </div>
  </div>
</section>
