---
import ProjectCard from "@/components/project/ProjectCard";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import type { IProject } from "@/interfaces/project";
import { localizedPath, useTranslations, type Locale } from "@/lib/i18n";
interface Props {
  projects: IProject[];
  locale: Locale;
}
const { projects, locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="projects" class="py-16 sm:py-24">
  <div class="mx-auto w-full max-w-[75rem] px-5 sm:px-8">
    <div
      class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >
      <div class="max-w-3xl">
        <p
          class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase"
        >
          {t("Home.lastProjects.label")}
        </p>
        <h2 class="mt-4 text-3xl font-bold tracking-[-0.035em] sm:text-5xl">
          {t("Home.lastProjects.title")}
        </h2>
        <p class="mt-4 text-lg text-content-muted">
          {t("Home.lastProjects.description")}
        </p>
      </div>
      <ButtonLink
        href={localizedPath(locale, "/projects")}
        variant="secondary"
        class="shrink-0">{t("Home.lastProjects.viewAll")}</ButtonLink
      >
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        projects.map((project) => (
          <ProjectCard
            project={project}
            href={localizedPath(locale, `/projects/${project.code}`)}
            labels={{
              viewProject: t("Projects.viewProjectLink", {
                title: project.title,
              }),
              impact: t("Home.lastProjects.impact"),
              caseStudy: t("Home.lastProjects.caseStudy"),
            }}
            variant="featured"
          />
        ))
      }
    </div>
  </div>
</section>
