---
import CircularPulse from "@/components/ui/CircularPulse.astro";
import GitHubIcon from "@/components/icon/GitHub.astro";
import GitLabIcon from "@/components/icon/GitLab.astro";
import LinkedInIcon from "@/components/icon/LinkedIn.astro";
import PresentationDownload from "./PresentationDownload.astro";
import { translate, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const profession = translate(locale, "Home.profession")
  .replaceAll(
    "<highlight>",
    '<span class="bg-slate-400 px-1 dark:bg-slate-500">',
  )
  .replaceAll("</highlight>", "</span>");
const description = translate(locale, "Home.description")
  .replaceAll(
    "<GreenHighlight>",
    '<span class="bg-green-300 px-1 dark:bg-green-500">',
  )
  .replaceAll("</GreenHighlight>", "</span>")
  .replaceAll(
    "<GrayHighlight>",
    '<span class="bg-gray-300 px-1 dark:bg-gray-500">',
  )
  .replaceAll("</GrayHighlight>", "</span>");
const socialClass =
  "flex items-center gap-3 rounded-md px-3 py-1 transition-colors hover:bg-gray-300 dark:text-white dark:hover:bg-gray-700";
---

<section id="presentation" class="relative w-full py-6">
  <div
    class="z-1 absolute bg-gradient-to-r from-gray-300 to-gray-200 dark:from-slate-800 dark:to-slate-700"
  >
  </div>
  <div
    class="z-2 container mx-auto flex flex-col-reverse items-center gap-3 px-4 text-center lg:flex lg:flex-row lg:space-x-5 lg:text-left"
  >
    <div class="flex max-w-full flex-col items-center space-y-4 lg:items-start">
      <div class="flex flex-col items-center gap-3 lg:items-start">
        <h1 class="text-md font-semibold">
          {translate(locale, "Home.greeting")}
        </h1>
        <p class="text-4xl font-semibold">{translate(locale, "Home.name")}</p>
        <h2 class="text-3xl font-semibold" set:html={profession} />
        <p class="text-lg" set:html={description} />
      </div>
      <div
        class="flex flex-row flex-wrap justify-center gap-2 lg:justify-start"
      >
        <a
          href="https://www.linkedin.com/in/franz-bendezu"
          class={socialClass}
          target="_blank"
          rel="noreferrer"><LinkedInIcon class="h-5 w-5" />LinkedIn</a
        >
        <a
          href="https://github.com/franz-bendezu"
          class={socialClass}
          target="_blank"
          rel="noreferrer"><GitHubIcon class="h-5 w-5" />GitHub</a
        >
        <a
          href="https://gitlab.com/franz-bendezu"
          class={socialClass}
          target="_blank"
          rel="noreferrer"><GitLabIcon class="h-5 w-5" />GitLab</a
        >
      </div>
      <div><PresentationDownload locale={locale} /></div>
    </div>
    <div class="flex max-w-full flex-shrink-0 items-center justify-center">
      <div
        class="relative flex aspect-square h-auto max-h-[512px] w-[512px] max-w-[512px] items-center justify-center"
      >
        <CircularPulse
          class="aspect-square h-auto max-w-[100%]"
          width="512"
          height="512"
        />
        <img
          src="/images/profile.webp"
          alt={locale === "es"
            ? "Retrato de Franz Bendezu"
            : "Portrait of Franz Bendezu"}
          fetchpriority="high"
          class="ma-auto relative z-10 max-h-[50%] max-w-[50%] rounded-full object-cover"
          width="256"
          height="256"
        />
      </div>
    </div>
  </div>
</section>
