---
import CircularPulse from "@/components/ui/CircularPulse.astro";
import GitHubIcon from "@/components/icon/GitHub.astro";
import LinkedInIcon from "@/components/icon/LinkedIn.astro";
import PresentationDownload from "./PresentationDownload.astro";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
import { getExperienceYears } from "@/lib/profile-content";
interface Props {
  locale: Locale;
  prefixEnglish?: boolean;
}
const { locale, prefixEnglish = false } = Astro.props;
const years = getExperienceYears();
const profession = translate(locale, "Home.profession")
  .replaceAll("<highlight>", '<span class="text-accent-strong">')
  .replaceAll("</highlight>", "</span>");
const description = translate(locale, "Home.description")
  .replaceAll("<GreenHighlight>", '<span class="font-semibold text-content">')
  .replaceAll("</GreenHighlight>", "</span>")
  .replaceAll("<GrayHighlight>", '<span class="font-semibold text-content">')
  .replaceAll("</GrayHighlight>", "</span>");
---

<section
  id="presentation"
  class="mx-auto w-full max-w-[75rem] px-5 py-12 sm:px-8 sm:py-16 lg:py-24"
>
  <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
    <div class="order-2 lg:order-1">
      <p
        class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase mb-5"
      >
        {translate(locale, "Home.greeting")}
      </p>
      <h1 class="text-4xl font-bold tracking-[-0.04em] sm:text-6xl">
        {translate(locale, "Home.name")}
      </h1>
      <h2
        class="mt-3 max-w-3xl text-3xl font-bold leading-[1.08] tracking-[-0.035em] sm:text-5xl"
        set:html={profession}
      />
      <p
        class="mt-6 max-w-2xl text-lg leading-relaxed text-content-muted sm:text-xl"
        set:html={description}
      />
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={localizedPath(locale, "/projects", prefixEnglish)}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-[0.65rem] border border-accent bg-accent px-4 py-2.5 text-sm font-bold text-white hover:-translate-y-0.5 hover:bg-[color-mix(in_srgb,var(--color-accent)_82%,black)]"
        >
          {translate(locale, "Home.viewWork")}
          <span aria-hidden="true">↗</span>
        </a>
        <PresentationDownload locale={locale} />
      </div>
      <div
        class="mt-7 flex flex-wrap items-center gap-2 text-sm text-content-muted"
      >
        <span class="mr-2 inline-flex items-center gap-2"
          ><span class="h-2 w-2 rounded-full bg-emerald-500"></span>{
            translate(locale, "Home.available")
          }</span
        >
        <a
          href="https://www.linkedin.com/in/franz-bendezu"
          class="rounded-md p-2 hover:text-accent-strong"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"><LinkedInIcon class="h-5 w-5" /></a
        >
        <a
          href="https://github.com/franz-bendezu"
          class="rounded-md p-2 hover:text-accent-strong"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"><GitHubIcon class="h-5 w-5" /></a
        >
      </div>
    </div>
    <div class="order-1 flex justify-center lg:order-2 lg:justify-end">
      <div
        class="relative flex aspect-square w-52 items-center justify-center sm:w-64 lg:w-[22rem]"
      >
        <CircularPulse
          class="absolute inset-0 h-full w-full opacity-70"
          width="512"
          height="512"
        />
        <img
          src="/images/profile.webp"
          alt={locale === "es"
            ? "Retrato de Franz Bendezu"
            : "Portrait of Franz Bendezu"}
          fetchpriority="high"
          class="relative z-10 aspect-square w-[52%] rounded-full object-cover ring-4 ring-surface-raised"
          width="256"
          height="256"
        />
      </div>
    </div>
  </div>
  <div class="mt-12 grid border-y border-divider sm:grid-cols-3">
    <div class="py-5 sm:pr-6">
      <strong class="block font-mono text-2xl text-accent-strong"
        >{years}+</strong
      ><span class="text-sm text-content-muted"
        >{translate(locale, "Home.proof.experience")}</span
      >
    </div>
    <div class="border-t border-divider py-5 sm:border-t-0 sm:border-l sm:px-6">
      <strong class="block font-mono text-lg">Backend · Frontend · Cloud</strong
      ><span class="text-sm text-content-muted"
        >{translate(locale, "Home.proof.focus")}</span
      >
    </div>
    <div class="border-t border-divider py-5 sm:border-t-0 sm:border-l sm:pl-6">
      <strong class="block font-mono text-sm leading-relaxed sm:text-base"
        >{translate(locale, "Home.proof.lifecycle")}</strong
      ><span class="text-sm text-content-muted"
        >{translate(locale, "Home.proof.delivery")}</span
      >
    </div>
  </div>
</section>

<style>
  #presentation {
    animation: reveal 500ms ease-out both;
  }

  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
