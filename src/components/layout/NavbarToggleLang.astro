---
import { LanguageIcon } from "@heroicons/react/20/solid";
import type { Locale } from "@/lib/i18n";

interface Props {
  otherLocale: Locale;
  href: string;
  label: string;
}

const { otherLocale, href, label } = Astro.props;
---

<a
  data-language-switch
  class="flex h-10 items-center rounded-md border border-divider px-2.5 text-xs font-bold text-content-muted hover:border-accent hover:text-accent-strong"
  {href}
  hreflang={otherLocale}
>
  <span class="mr-1">
    <LanguageIcon className="h-5 w-5" aria-hidden="true" />
  </span>
  {label}
</a>
