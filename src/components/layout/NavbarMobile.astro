---
import { Bars4Icon } from "@heroicons/react/20/solid";
import NavLink from "./NavLink.astro";
import { ROUTES_NAVBAR } from "@/constants/navbar";
import { localizedPath, translate, type Locale } from "@/lib/i18n";

interface Props {
  locale: Locale;
  currentPath: string;
  prefixEnglish: boolean;
}

const { locale, currentPath, prefixEnglish } = Astro.props;
---

<details class="group relative md:hidden">
  <summary
    class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-content marker:hidden hover:bg-surface-muted"
    aria-label={locale === "es" ? "Abrir menú principal" : "Open main menu"}
  >
    <span class="sr-only"
      >{locale === "es" ? "Abrir menú principal" : "Open main menu"}</span
    >
    <Bars4Icon className="h-6 w-6" aria-hidden="true" />
  </summary>
  <div
    class="rounded-2xl border border-divider bg-surface-raised shadow-editorial absolute right-0 top-12 z-30 min-w-56 origin-top-right p-2"
  >
    <div class="space-y-1">
      {
        ROUTES_NAVBAR.map((route) => {
          const active = route.exact
            ? currentPath === route.path
            : currentPath.startsWith(route.path);
          return (
            <NavLink
              href={localizedPath(locale, route.path, prefixEnglish)}
              active={active}
              class="block rounded-md font-medium hover:bg-surface-muted"
              activeClass="rounded-md bg-accent-soft font-bold text-accent-strong"
            >
              {translate(locale, `Navigation.${route.title}`)}
            </NavLink>
          );
        })
      }
    </div>
  </div>
</details>
