---
import { Bars4Icon } from "@heroicons/react/20/solid";
import NavLink from "./NavLink.astro";
import { ROUTES_NAVBAR } from "@/constants/navbar";
import { useLocalizedPath, useTranslations, type Locale } from "@/lib/i18n";
import cardStyles from "@/components/ui/Card.module.css";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const localizePath = useLocalizedPath(locale);
const t = useTranslations(locale);
---

<details class="group relative md:hidden">
  <summary
    class="inline-flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md text-content marker:hidden hover:bg-surface-muted"
    aria-label={t("Navigation.openMenu")}
  >
    <span class="sr-only">{t("Navigation.openMenu")}</span>
    <Bars4Icon className="h-6 w-6" aria-hidden="true" />
  </summary>
  <div
    class:list={[
      cardStyles.base,
      "absolute right-0 top-12 z-30 min-w-56 origin-top-right p-2",
    ]}
  >
    <div class="space-y-1">
      {
        ROUTES_NAVBAR.map((route) => {
          const { path } = route;
          const active = route.exact
            ? currentPath === path
            : currentPath.startsWith(path);
          return (
            <NavLink
              href={localizePath(path)}
              active={active}
              class="block rounded-md font-medium hover:bg-surface-muted"
              activeClass="rounded-md bg-accent-soft font-bold text-accent-strong"
            >
              {t(`Navigation.${route.title}`)}
            </NavLink>
          );
        })
      }
    </div>
  </div>
</details>
