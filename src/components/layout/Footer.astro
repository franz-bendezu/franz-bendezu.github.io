---
import TwitterIcon from "@/components/icon/Twitter.astro";
import GitHubIcon from "@/components/icon/GitHub.astro";
import LinkedInIcon from "@/components/icon/LinkedIn.astro";
import { translate, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const linkClass =
  "flex items-center gap-3 transition-colors hover:text-yellow-500";
---

<footer class="px-6 py-10 text-gray-800 dark:text-white">
  <div class="container mx-auto">
    <div class="flex flex-col items-center justify-between lg:flex-row">
      <p class="mb-6 lg:mb-0">{translate(locale, "Footer.madeWith")}</p>
      <div class="flex flex-wrap space-x-4 font-medium">
        <a
          href="https://twitter.com/franz_bendezu"
          class={linkClass}
          target="_blank"
          rel="noreferrer"><TwitterIcon class="h-5 w-5" />Twitter</a
        >
        <a
          href="https://www.linkedin.com/in/franz-antony-bendezu-isidro/"
          class={linkClass}
          target="_blank"
          rel="noreferrer"><LinkedInIcon class="h-5 w-5" />LinkedIn</a
        >
        <a
          href="https://github.com/franz-bendezu"
          class={linkClass}
          target="_blank"
          rel="noreferrer"><GitHubIcon class="h-5 w-5" />GitHub</a
        >
      </div>
    </div>
  </div>
</footer>
