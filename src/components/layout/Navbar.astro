---
import { CodeBracketSquareIcon } from "@heroicons/react/20/solid";
import NavbarNavigation from "./NavbarNavigation.astro";
import { localizedPath, stripLocale, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
  path: string;
  pathname: string;
  languagePath?: string;
}
const {
  locale,
  path,
  pathname,
  languagePath: alternateLanguagePath,
} = Astro.props;
const prefixEnglish = pathname === "/en" || pathname.startsWith("/en/");
const currentPath = stripLocale(pathname);
const otherLocale: Locale = locale === "en" ? "es" : "en";
const languagePath = localizedPath(otherLocale, alternateLanguagePath ?? path);
const homePath = localizedPath(locale, "/", prefixEnglish);
---

<nav
  class="sticky top-0 z-40 border-b border-divider bg-surface/90 py-3 backdrop-blur-xl"
>
  <div
    class="max-w-[75rem] w-full mx-auto flex items-center justify-between px-4"
  >
    <a
      href={homePath}
      class="flex items-center gap-2 font-bold tracking-[0.1em] uppercase hover:text-accent-strong"
    >
      <CodeBracketSquareIcon
        className="h-5 w-5 text-accent"
        aria-hidden="true"
      />
      <span class="hidden sm:inline">Franz Bendezu</span><span class="sm:hidden"
        >FB</span
      >
    </a>
    <NavbarNavigation
      locale={locale}
      currentPath={currentPath}
      prefixEnglish={prefixEnglish}
      otherLocale={otherLocale}
      languagePath={languagePath}
    />
  </div>
</nav>
