---
import NavLink from "./NavLink.astro";
import { ROUTES_NAVBAR } from "@/constants/navbar";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
interface Props {
  locale: Locale;
  currentPath: string;
  prefixEnglish: boolean;
}
const { locale, currentPath, prefixEnglish } = Astro.props;
---

<div class="hidden items-center md:mx-2 md:flex md:gap-1 lg:mx-3">
  {
    ROUTES_NAVBAR.map((route) => {
      const { path } = route;
      const active = route.exact
        ? currentPath === path
        : currentPath.startsWith(path);
      return (
        <NavLink
          href={localizedPath(locale, path, prefixEnglish)}
          active={active}
          activeClass="text-accent-strong font-bold"
        >
          {translate(locale, `Navigation.${route.title}`)}
        </NavLink>
      );
    })
  }
</div>
