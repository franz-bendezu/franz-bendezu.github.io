---
interface Props {
  href: string;
  active: boolean;
  class?: string;
  activeClass?: string;
}
const {
  href,
  active,
  class: className = "",
  activeClass = "text-accent-strong font-bold",
} = Astro.props;
---

<a
  {href}
  aria-current={active ? "page" : undefined}
  class:list={[
    className,
    "relative rounded-md px-3 py-2 text-sm",
    active ? activeClass : "font-medium text-content-muted hover:text-content",
  ]}
>
  <slot />
  {
    active && (
      <span
        class="absolute inset-x-3 -bottom-0.5 h-0.5 bg-accent"
        aria-hidden="true"
      />
    )
  }
</a>
