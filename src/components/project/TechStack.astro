---
import type { IProjectTechnology } from "@/interfaces/project";
interface Props {
  techs: IProjectTechnology[];
}
const { techs } = Astro.props;
---

<div class="mt-2 flex flex-row flex-wrap justify-between gap-2">
  {
    techs.map((tech) => (
      <span class="flex flex-row gap-2 rounded px-2 py-1 text-xs text-black outline outline-1 lg:text-sm dark:text-white">
        {tech.logo && (
          <img
            src={tech.logo}
            alt=""
            class="h-4 w-4"
            width="16"
            height="16"
            loading="lazy"
          />
        )}
        {tech.name}
      </span>
    ))
  }
</div>
