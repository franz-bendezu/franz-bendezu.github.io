---
import type { IBaseProjectTechnology } from "@/interfaces/project";
import { translate, type Locale } from "@/lib/i18n";
interface Props {
  techs: IBaseProjectTechnology[];
  locale: Locale;
}
const { techs, locale } = Astro.props;
---

<section>
  <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl">
    {translate(locale, "Project.technologies")}
  </h2>
  <div class="mt-6 grid grid-cols-2 gap-4">
    {
      techs.map((tech) => (
        <div class="rounded-lg bg-slate-200 p-4 text-center dark:bg-slate-700">
          {tech.logo && (
            <img
              src={tech.logo}
              alt=""
              class="mx-auto h-8 w-8"
              width="32"
              height="32"
              loading="lazy"
            />
          )}
          <p class="mt-2 text-sm font-medium">{tech.name}</p>
        </div>
      ))
    }
  </div>
</section>
