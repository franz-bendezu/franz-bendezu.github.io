---
import type { IBaseProject } from "@/interfaces/project";
import { translate, type Locale } from "@/lib/i18n";
interface Props {
  project: IBaseProject;
  locale: Locale;
}
const { project, locale } = Astro.props;
---

<section class="space-y-6">
  <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl">
    {translate(locale, "Project.features")}
  </h2>
  <div class="flex flex-col gap-2">
    {
      project.keyFeatures.map((feature) => (
        <div class="flex flex-col gap-1 rounded-lg bg-slate-200 p-6 dark:bg-slate-700">
          <>
            <h3 class="text-xl font-bold">{feature.title}</h3>
            <p>{feature.description}</p>
          </>
        </div>
      ))
    }
  </div>
</section>
