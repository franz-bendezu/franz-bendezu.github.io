---
import type { IBaseProject } from "@/interfaces/project";
interface Props {
  project: IBaseProject;
}
const { project } = Astro.props;
---

<section class="border-b">
  <div
    class="grid gap-10 px-4 py-6 md:px-6 md:py-8 lg:grid-cols-2 lg:gap-20 lg:py-12"
  >
    <div class="order-2 space-y-4 lg:order-1">
      <div
        class="inline-block rounded-lg bg-slate-200 px-3 py-1 text-sm dark:bg-slate-700"
      >
        {project.categoryCode}
      </div>
      <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl md:text-6xl">
        {project.title}
      </h1>
      <p
        class="max-w-[600px] md:text-xl/relaxed lg:text-base/relaxed xl:text-xl/relaxed"
      >
        {project.shortDescription}
      </p>
      <div class="flex flex-col gap-2 min-[400px]:flex-row">
        {
          project.links?.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block rounded-md bg-slate-500 px-4 py-2 text-sm font-medium text-white hover:bg-slate-600 dark:bg-slate-700 dark:hover:bg-slate-800"
            >
              {link.title}
            </a>
          ))
        }
      </div>
    </div>
    {
      project.banner && (
        <div class="relative order-1 flex items-center justify-center lg:order-2">
          <img
            src={project.banner.src}
            alt={project.banner.alt}
            width="828"
            height="450"
            class="mx-auto aspect-video h-full w-auto overflow-hidden rounded-xl object-contain object-center"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>
