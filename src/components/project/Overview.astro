---
import { translate, type Locale } from "@/lib/i18n";
interface Props {
  description: string;
  locale: Locale;
}
const { description, locale } = Astro.props;
---

<section>
  <div class="space-y-12 px-4 md:px-6">
    <div>
      <h2 class="text-3xl font-bold tracking-tighter sm:text-4xl">
        {translate(locale, "Project.overview")}
      </h2>
      <p class="mt-4 md:text-xl">{description}</p>
    </div>
  </div>
</section>
