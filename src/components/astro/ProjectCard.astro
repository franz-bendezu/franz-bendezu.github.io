---
import type { IProject } from "@/interfaces/project";
import { localizedPath, translate, type Locale } from "@/lib/i18n";
interface Props {
  project: IProject;
  locale: Locale;
  prefixEnglish?: boolean;
}
const { project, locale, prefixEnglish = false } = Astro.props;
const initials = project.title
  .split(/\s+/)
  .slice(0, 2)
  .map((word) => word[0])
  .join("");
const period = [project.start?.slice(0, 4), project.end?.slice(0, 4)]
  .filter(Boolean)
  .join("–");
---

<article
  data-featured-project={project.featured ? "true" : undefined}
  class="rounded-2xl border border-divider bg-surface-raised shadow-editorial group flex min-w-0 flex-col overflow-hidden hover:-translate-y-1 hover:border-accent"
>
  <a
    class="flex h-full flex-col"
    aria-label={translate(locale, "Projects.viewProjectLink", {
      title: project.title,
    })}
    href={localizedPath(locale, `/projects/${project.code}`, prefixEnglish)}
  >
    <div
      class="aspect-video overflow-hidden border-b border-divider bg-surface-muted"
    >
      {
        project.banner ? (
          <img
            class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
            src={project.banner.src}
            alt={project.banner.alt}
            width="640"
            height="360"
            loading="lazy"
          />
        ) : (
          <div class="flex h-full items-center justify-center font-mono text-4xl font-bold text-accent-strong">
            {initials}
          </div>
        )
      }
    </div>
    <div class="flex flex-1 flex-col p-5">
      <div
        class="flex items-center justify-between gap-3 font-mono text-xs uppercase tracking-wider text-content-muted"
      >
        <span>{project.categoryCode}</span><span>{period}</span>
      </div>
      <h3 class="mt-4 text-xl font-bold leading-tight">{project.title}</h3>
      {
        project.role && (
          <p class="mt-2 text-sm font-semibold text-accent-strong">
            {project.role}
          </p>
        )
      }
      <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-content-muted">
        {project.shortDescription}
      </p>
      {
        project.outcomes?.[0] && (
          <div class="mt-5 border-l-2 border-accent pl-3">
            <>
              <span class="font-mono text-xs font-bold tracking-[0.12em] text-accent-strong uppercase">
                {translate(locale, "Home.lastProjects.impact")}
              </span>
              <p class="mt-1 text-sm font-medium">{project.outcomes[0]}</p>
            </>
          </div>
        )
      }
      <div class="mt-auto flex flex-wrap gap-2 pt-6">
        {
          project.technologies
            .slice(0, 3)
            .map((tech) => (
              <span class="rounded-full border border-divider px-2 py-1 font-mono text-[0.68rem]">
                {tech.name}
              </span>
            ))
        }
      </div>
      <span
        class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-accent-strong"
        >{translate(locale, "Home.lastProjects.caseStudy")}
        <span aria-hidden="true">→</span></span
      >
    </div>
  </a>
</article>
