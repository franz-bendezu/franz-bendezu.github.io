---
import styles from "./CircularPulse.module.css";
interface Props {
  class?: string;
  width?: string | number;
  height?: string | number;
}
const { class: className = "", width, height } = Astro.props;
---

<svg
  class:list={[
    "pointer-events-none absolute inset-0 left-1/2 top-1/2 z-0 block -translate-x-1/2 -translate-y-1/2 transform rounded-full",
    className,
  ]}
  {width}
  {height}
  viewBox="0 0 800 800"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g class="fill-slate-500 opacity-75 dark:fill-slate-300">
    <circle class={styles.pulse} cx="400" cy="400" r="200"></circle>
    <circle
      class:list={[styles.pulse, styles["pulse-1"]]}
      cx="400"
      cy="400"
      r="200"></circle>
    <circle
      class:list={[styles.pulse, styles["pulse-2"]]}
      cx="400"
      cy="400"
      r="200"></circle>
    <circle
      class:list={[styles.pulse, styles["pulse-3"]]}
      cx="400"
      cy="400"
      r="200"></circle>
  </g>
</svg>
